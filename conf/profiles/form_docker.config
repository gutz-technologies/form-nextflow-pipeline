// ─────────────────────────────────────────────────────────────────────────────
// FORM pinned bioBakery images, outside DNAnexus. Combine with a site profile:
//
//   nextflow run . -profile local,form_docker --host_genome /db/hg39T2T ...
//
// The images come from bioBakery's public ECR registry (public.ecr.aws/j5i5h1i5,
// the registry bioBakery's own aws profile uses). The Docker Hub biobakery/*
// images are older (kneaddata 0.10.0) and do not meet FORM's minimums. Each
// image is pinned by registry digest, because tags in this registry move.
//
//   KneadData  0.12.1 (CLI v0.12.0), Bowtie2 2.5.5, Trimmomatic 0.40, TRF 4.10.0rc2
//   MetaPhlAn  4.2.5, Bowtie2 2.5.5
//   HUMAnN     4.0.0a2, DIAMOND 2.0.15, Bowtie2 2.5.5
//
// The images start with a dxfuse entrypoint that mounts DNAnexus references.
// Off DNAnexus that fails with "DNAnexus references: set DX_REFERENCE_PROJECT
// ...", so DXFUSE_ENABLED=false is passed to every container. The images'
// default user is mambauser (UID 57439); -u runs tasks as the launching user
// so they can write to the work directory.
//
// MEDI uses its own container params. The visualization and stats reports
// are not containerised here; supply their tools or pass --run_vis false.
// ─────────────────────────────────────────────────────────────────────────────

params {
    kneaddata_container = 'public.ecr.aws/j5i5h1i5/kneaddata@sha256:87f9fe73578cffa73d30e08c90099e1fdf69831c42778d3b2a7cd7791f8ae4b3'
    metaphlan_container = 'public.ecr.aws/j5i5h1i5/metaphlan@sha256:bcbba3807ce7bbfda6526dd8598232025c9cc9a3f7689b9ad639dab9d8c81787'
    humann_container    = 'public.ecr.aws/j5i5h1i5/humann@sha256:3d245ae23c5b5015e6ca2a16b5963c0d178fd5f0786890e7eb57fa8cf7fe2acd'

    // bioBakery's paired-end command passes --processes ${task.cpus} and no
    // --threads, so Bowtie2 and Trimmomatic run with one thread. kneaddata_options
    // is appended last, so this restores the thread count. Keep it equal to the
    // cpus below. If you set kneaddata_options yourself, include --threads 8.
    kneaddata_options   = '--threads 8'
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g) -e DXFUSE_ENABLED=false'
}

process {
    withName: 'single_end_kneaddata|paired_end_kneaddata|kneaddata_read_counts' {
        container = { params.kneaddata_container }
    }
    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        cpus = 8
    }
    withName: 'metaphlan|metaphlan_bzip|metaphlan_merge|metaphlan_species_counts' {
        container = { params.metaphlan_container }
    }
    withName: 'humann|humann_regroup|humann_regroup_ecs|humann_rename|humann_renorm|humann_join|humann_join_relab|humann_count_features|humann_feature_counts_merge|humann_log_counts|rna_dna_norm' {
        container = { params.humann_container }
    }
}
