// FORM parameters: MEDI, plus the bioBakery defaults FORM changes. Everything
// else is bioBakery's default (biobakery/conf/params.config).

params {

    // ── bioBakery defaults FORM changes ────────────────────────────────────
    workflow       = 'mgx'         // FORM runs MGX only
    humann_version = 'humann_v4a'  // medi_input humann needs HUMAnN 4's unaligned reads

    // ── Food DNA quantification (MEDI) ─────────────────────────────────────
    run_medi           = true
    medi_input         = 'humann'  // humann (HUMAnN 4 unaligned reads) | kneaddata (cleaned reads)
    medi_db            = null      // REQUIRED: Kraken2/Bracken DB, taxo.k2d and taxonomy/
    medi_food_matches  = null      // REQUIRED: MEDI food-to-taxon matches table
    medi_food_contents = null      // REQUIRED: MEDI food contents table
    medi_container         = 'colinbrislawn/medi:1.0.1'
    // The converter needs pandas, numpy, biom-format and HDF5; MultiQC is
    // separate, matching the reference workflow's tool environments.
    medi_biom_container    = 'colinbrislawn/metaphlan:4.2.4'
    medi_multiqc_container = 'ghcr.io/multiqc/multiqc:v1.22.3'
}
