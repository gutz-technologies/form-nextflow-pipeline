// MEDI process resources. check_max() is defined in biobakery/conf/base.config.

process {
    // Full MEDI Kraken2 DB needs about 415 GB. Raise max_memory above the
    // default 128 GB on a node with enough RAM; check_max still caps retries.
    withLabel: medi_kraken {
        cpus   = { check_max(8      * task.attempt, 'cpus')   }
        memory = { check_max(415.GB * task.attempt, 'memory') }
        time   = { check_max(24.h   * task.attempt, 'time')   }
    }
    withLabel: medi_low {
        cpus   = { check_max(2     * task.attempt, 'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }
}
