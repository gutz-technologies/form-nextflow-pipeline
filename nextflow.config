// ═════════════════════════════════════════════════════════════════════════════
// form-nextflow-pipeline
//
// The bioBakery MGX workflow (biobakery/, a git submodule of upstream
// biobakery/biobakery-nextflow) followed by MEDI food DNA quantification.
//
// bioBakery's own config comes first and is used as is; FORM's files then add
// the MEDI settings and change the few defaults FORM needs. Later wins:
//
//   1. biobakery/conf/params.config    bioBakery parameter defaults
//   2. biobakery/conf/base.config      bioBakery process resources
//   3. biobakery/conf/reports.config   timeline/report/trace/dag
//   4. conf/params.config              MEDI parameters, FORM defaults
//   5. conf/base.config                MEDI process resources
//   6. -profile                        bioBakery's site profiles (+ FORM additions)
//   7. -params-file, then the command line
// ═════════════════════════════════════════════════════════════════════════════

manifest {
    name              = 'form-nextflow-pipeline'
    author            = 'Gutz Technologies'
    homePage          = 'https://github.com/gutz-technologies/form-nextflow-pipeline'
    description       = 'bioBakery MGX plus MEDI food DNA quantification for FORM'
    mainScript        = 'main.nf'
    version           = '0.1.0'
    nextflowVersion   = '>=24.04.0'
    recurseSubmodules = true
}

includeConfig 'biobakery/conf/params.config'
includeConfig 'biobakery/conf/base.config'
includeConfig 'biobakery/conf/reports.config'

includeConfig 'conf/params.config'
includeConfig 'conf/base.config'

// Same names and pairings as bioBakery's nextflow.config.
profiles {
    local     { includeConfig 'biobakery/conf/profiles/local.config' }
    standard  { includeConfig 'biobakery/conf/profiles/local.config' }

    harvard_rc {
        includeConfig 'biobakery/conf/profiles/harvard_rc.config'
        includeConfig 'biobakery/conf/databases/harvard_rc.config'
    }

    tufts_hpc {
        includeConfig 'biobakery/conf/profiles/tufts_hpc.config'
        includeConfig 'biobakery/conf/databases/tufts.config'
    }

    amazon    { includeConfig 'biobakery/conf/profiles/aws.config' }
}
