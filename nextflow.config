// ═════════════════════════════════════════════════════════════════════════════
// form-nextflow-pipeline
//
// The bioBakery MGX workflow (biobakery/, a git submodule of upstream
// biobakery/biobakery-nextflow) followed by MEDI food DNA quantification.
//
// bioBakery's own config comes first and is used as is; FORM's files then add
// the MEDI settings and change the few defaults FORM needs. Later wins:
//
//   1. biobakery/conf/params.config    bioBakery parameter defaults
//   2. biobakery/conf/base.config      bioBakery process resources
//   3. biobakery/conf/reports.config   timeline/report/trace/dag
//   4. conf/params.config              MEDI parameters, FORM defaults
//   5. conf/base.config                MEDI process resources
//   6. -profile                        bioBakery's site profiles (+ FORM additions)
//   7. -params-file, then the command line
// ═════════════════════════════════════════════════════════════════════════════

manifest {
    name              = 'form-nextflow-pipeline'
    author            = 'Gutz Technologies'
    homePage          = 'https://github.com/gutz-technologies/form-nextflow-pipeline'
    description       = 'bioBakery MGX plus MEDI food DNA quantification for FORM'
    mainScript        = 'main.nf'
    version           = '0.1.0'
    nextflowVersion   = '>=25.04.0'
    recurseSubmodules = true
}

includeConfig 'biobakery/conf/params.config'
includeConfig 'biobakery/conf/base.config'
includeConfig 'biobakery/conf/reports.config'

includeConfig 'conf/params.config'
includeConfig 'conf/base.config'

// Same names and pairings as bioBakery's nextflow.config.
profiles {
    local     { includeConfig 'biobakery/conf/profiles/local.config' }
    standard  { includeConfig 'biobakery/conf/profiles/local.config' }

    // FORM addition: pinned KneadData image for runs outside DNAnexus.
    // Combine with a site profile, e.g. -profile local,form_docker.
    form_docker { includeConfig 'conf/profiles/form_docker.config' }

    harvard_rc {
        includeConfig 'biobakery/conf/profiles/harvard_rc.config'
        includeConfig 'biobakery/conf/databases/harvard_rc.config'
    }

    tufts_hpc {
        includeConfig 'biobakery/conf/profiles/tufts_hpc.config'
        includeConfig 'biobakery/conf/databases/tufts_hpc.config'
    }

    amazon    { includeConfig 'biobakery/conf/profiles/amazon.config' }

    // DNAnexus with references downloaded from <project>:/Databases to worker
    // SSD (bioBakery PR 34). host_genome = /Databases/kneaddata: put only the
    // six GCA_009914755.4_T2T*.bt2 files there.
    dnanexus_download {
        includeConfig 'biobakery/conf/profiles/dnanexus.config'
        includeConfig 'biobakery/conf/databases/dnanexus.config'
        includeConfig 'biobakery/conf/profiles/dnanexus_download.config'
        includeConfig 'biobakery/conf/databases/dnanexus_download.config'
        process {
            // FORM sizing, kept here so the bioBakery submodule stays unedited.
            // We launch subjobs at --priority low (spot) with the head job on
            // demand (--head-job-on-demand). At spot prices a 64 GB x16 instance
            // costs little more than a 32 GB one, so HUMAnN (peak ~14-23 GB) starts
            // at 64 GB and steps up to 128 GB on retry. For on-demand runs a cheaper
            // ladder is ['mem1_ssd1_v2_x16','mem2_ssd1_v2_x16','mem3_ssd1_v2_x16'].
            // Fully qualified selector: a bare 'humann' key would replace
            // bioBakery's base.config humann block (cpus/time) instead of adding to it.
            withName: '.*:FUNCTIONAL_PROFILING:humann' {
                machineType = { def l = params.dnanexus_humann_machine_types; l[Math.min(task.attempt, l.size()) - 1] }
                memory      = { [60.GB, 120.GB][Math.min(task.attempt, 2) - 1] }
            }
            // bioBakery retries kill codes (137 etc.). A reclaimed spot worker
            // can end a task with no exit code (Nextflow reports Integer.MAX_VALUE),
            // so retry that too. maxRetries stays bioBakery's 2.
            errorStrategy = { task.exitStatus in [125, 143, 137, 104, 134, 139, Integer.MAX_VALUE] ? 'retry' : 'finish' }
        }
    }
}
