// Small resources so MEDI's 415 GB Kraken2 request can stub-run anywhere.
process {
    withName: '.*' {
        cpus   = 1
        memory = '1.GB'
    }
}
params {
    medi_db            = '/dummy/medi'
    medi_food_matches  = '/dummy/matches.csv'
    medi_food_contents = '/dummy/contents.csv'
}
